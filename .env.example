# Anthropic API Key
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn OAuth2 App
# Créez une app sur https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret

# URL de callback OAuth (localhost par défaut)
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback

# Contexte professionnel (optionnel, améliore la pertinence des posts)
# Exemples: "développeur logiciel senior", "entrepreneur tech", "consultant RH"
PROFESSIONAL_CONTEXT=

# Langue des posts générés (fr ou en, défaut: fr)
POST_LANGUAGE=fr
